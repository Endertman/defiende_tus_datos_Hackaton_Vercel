# --- IA ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Email (Resend) ---
# Para hackathon: usamos onresend.com de prueba.
# FROM_EMAIL puede ser: onboarding@resend.dev (dominio de prueba de Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@resend.dev
# Correo del equipo donde llegan las copias / notificaciones internas
USER_NOTIFY_EMAIL=tu-correo-alterno@gmail.com

# --- WhatsApp (Twilio Sandbox) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Sandbox por defecto de Twilio
TWILIO_WHATSAPP_FROM=+14155238886
# Tu número personal vinculado al sandbox (para recibir notificaciones)
NOTIFY_WHATSAPP_TO=+5699...

# --- Vercel KV ---
# Crear en Vercel Dashboard → Storage → KV → Create
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Cron / endpoint protegido ---
CRON_SECRET=cualquier-string-largo-aleatorio

# --- URLs internas (necesario para el webhook de WhatsApp) ---
# En local: http://localhost:3000 / En Vercel: https://tu-deploy.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Demo: correo mock del banco (a donde se envían los reclamos de prueba) ---
# Pon aquí los correos alternativos del equipo
MOCK_BANK_EMAIL=correo-alterno-banco@gmail.com
